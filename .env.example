# Copy this file to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# Authorized target only. Can be any domain, subdomain, or IP you own
# or are explicitly authorized to test -- a lab target (e.g. your own
# Juice Shop instance) or a publicly hosted site of yours. Used by the
# single-agent CLI (cli.py); the web UI lets you enter a target per scan
# instead, so this is just a default/fallback.
TARGET_ORIGIN=http://127.0.0.1:3000

# Toggle retrieval augmentation on/off for the E2/E3-style comparison.
RAG_ENABLED=false

# Optional: a free NVD API key raises the correlate agent's CVE lookup
# rate limit from ~5/30s to ~50/30s. Request one at
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional: which interface/port the web UI binds to. Defaults to
# 0.0.0.0:5000 (reachable from any machine on your network at
# http://<this-server's-LAN-IP>:5000/ -- there's no login on this web
# UI besides the per-scan authorization checkbox, so only expose it on
# a network you trust). Set WEBUI_HOST=127.0.0.1 to restrict it to
# this machine only.
#WEBUI_HOST=0.0.0.0
#WEBUI_PORT=5000
